+void CodeTextEditor::_phone_wrap_toggled(bool p_enabled) {
+	// A display preference only: no text rewriting, undo operation or IME commit.
+	EditorSettings::get_singleton()->set("text_editor/appearance/lines/word_wrap", p_enabled ? TextEdit::LINE_WRAPPING_BOUNDARY : TextEdit::LINE_WRAPPING_NONE);
+	text_editor->set_line_wrapping_mode(p_enabled ? TextEdit::LINE_WRAPPING_BOUNDARY : TextEdit::LINE_WRAPPING_NONE);
+	if (p_enabled) {
+		text_editor->set_h_scroll(0);
+	}
+}
