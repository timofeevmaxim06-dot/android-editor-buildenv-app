+void EditorNode::execute_phone_action(int p_action) {
+	// Route through the editor's existing save/run lifecycle and error dialogs.
+	if (ScriptEditor *script_editor = ScriptEditor::get_singleton()) {
+		if (ScriptEditorBase *current = script_editor->get_current_editor()) {
+			if (TextEditorBase *text = Object::cast_to<TextEditorBase>(current)) {
+				text->get_code_editor()->get_text_editor()->apply_ime();
+			}
+		}
+	}
+#ifdef ANDROID_ENABLED
+	DisplayServer::get_singleton()->virtual_keyboard_hide();
+#endif
+	switch (p_action) {
+		case 0: project_run_bar->play_main_scene(); break;
+		case 1: project_run_bar->play_current_scene(); break;
+		case 2: project_run_bar->stop_playing(); break;
+		case 3: {
+			ScriptEditor::get_singleton()->save_all_scripts();
+			_menu_option(SCENE_SAVE_ALL_SCENES);
+		} break;
+		case 4: _menu_option(EDITOR_OPEN_SETTINGS); break;
+		case 5: _menu_option(PROJECT_EXPORT); break;
+	}
+}
