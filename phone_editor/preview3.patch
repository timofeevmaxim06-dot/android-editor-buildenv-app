+
+void TextEdit::_phone_end_handle() {
+	if (phone_handle_finger < 0) {
+		return;
+	}
+	phone_handle_finger = -1;
+	selection_handle_drag_type = SELECTION_HANDLE_NONE;
+	dragging_caret_index = -1;
+	_cancel_inertial_scroll();
