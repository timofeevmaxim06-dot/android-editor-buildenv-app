+void ScriptEditor::toggle_phone_chrome() {
+	phone_compact = !phone_compact;
+	phone_menu_visible = !phone_compact;
+	EditorSettings::get_singleton()->set_project_metadata("phone_editor", "compact", phone_compact);
+	EditorSettings::get_singleton()->set_project_metadata("phone_editor", "menu_visible", phone_menu_visible);
+	update_phone_chrome();
+}
+
+void ScriptEditor::update_phone_chrome() {
+	if (!is_inside_tree() || !(bool)EDITOR_GET("interface/touchscreen/phone_single_panel_mode")) {
+		return;
+	}
+	bool keyboard_visible = false;
+#ifdef ANDROID_ENABLED
+	keyboard_visible = is_visible_in_tree() && DisplayServer::get_singleton()->virtual_keyboard_get_height() > 0;
+#endif
+	// Help tabs have no code toolbar, so they must retain the normal navigation.
+	const bool compact = is_visible_in_tree() && Object::cast_to<TextEditorBase>(_get_current_editor()) && (phone_compact || keyboard_visible);
+	if (compact) {
+		Control *code_status = nullptr;
+		if (CodeTextEditor *code_editor = Object::cast_to<TextEditorBase>(_get_current_editor())->get_code_editor()) {
+			code_status = Object::cast_to<Control>(code_editor->find_child("PhoneCodeStatus", true, false));
+		}
+		Control *base = EditorNode::get_singleton()->get_gui_base();
+		Control *chrome[] = {
+			Object::cast_to<Control>(base->find_child("PhoneTopBarScroll", true, false)),
+			EditorSceneTabs::get_singleton(),
+			code_status,
+		};
+		for (Control *control : chrome) {
+			if (control) {
+				const ObjectID id = control->get_instance_id();
+				if (!phone_hidden_chrome.has(id)) {
+					phone_hidden_chrome.insert(id, control->is_visible());
+				}
+				control->hide();
+			}
+		}
+	} else {
+		for (const KeyValue<ObjectID, bool> &entry : phone_hidden_chrome) {
+			if (Control *control = Object::cast_to<Control>(ObjectDB::get_instance(entry.key))) {
+				control->set_visible(entry.value);
+			}
+		}
+		phone_hidden_chrome.clear();
+	}
+	if (phone_menu_scroll) {
+		phone_menu_scroll->set_visible(!compact || (phone_menu_visible && !keyboard_visible));
+	}
+}
+
+
+void ScriptEditor::_phone_select_navigator(bool p_functions) {
+	phone_nav_functions = p_functions;
+	_phone_sync_navigator();
+}
+
+void ScriptEditor::_phone_sync_navigator() {
+	if (!phone_scripts_tab || !phone_functions_tab) { return; }
+	scripts_vbox->set_visible(!phone_nav_functions);
+	overview_vbox->set_visible(phone_nav_functions);
+	phone_scripts_tab->set_pressed_no_signal(!phone_nav_functions);
+	phone_functions_tab->set_pressed_no_signal(phone_nav_functions);
+}
+
+void ScriptEditor::_phone_adjust_caret_after_resize() {
+	if (TextEditorBase *editor = Object::cast_to<TextEditorBase>(_get_current_editor())) {
+		if (CodeTextEditor *code_editor = editor->get_code_editor()) {
+			CodeEdit *code = code_editor->get_text_editor();
+			if (code && code->has_focus() && code->get_visible_line_count() > 0) {
+				code->adjust_viewport_to_caret();
+			}
+		}
+	}
+}
+
+void ScriptEditor::_update_phone_script_list_layout() {
+	if (!is_inside_tree() || !tab_container || !(bool)EDITOR_GET("interface/touchscreen/phone_single_panel_mode")) { return; }
+	const Size2 window_size = get_viewport()->get_visible_rect().size;
+	const real_t available_width = MIN(get_size().x, window_size.x) - 16 * EDSCALE;
+	Control *code_container = Object::cast_to<Control>(tab_container->get_parent());
+	const bool stacked = window_size.y > window_size.x || available_width < 620 * EDSCALE;
+	const bool changed = !phone_nav_layout_ready || script_split->is_vertical() != stacked;
+	if (changed) {
+		script_split->set_vertical(stacked);
+		phone_nav_layout_ready = true;
+		script_split->set_split_offset(0);
+	}
+	list_split->set_v_size_flags(stacked ? SIZE_FILL : SIZE_EXPAND_FILL);
+	list_split->set_h_size_flags(stacked ? SIZE_EXPAND_FILL : SIZE_FILL);
+	list_split->set_custom_minimum_size(stacked ? Size2(0, MIN(180 * EDSCALE, window_size.y * 0.25f)) : Size2(MIN(230 * EDSCALE, available_width * 0.35f), 0));
+	list_split->set_custom_maximum_size(stacked ? Size2(-1, window_size.y * 0.40f) : Size2(available_width * 0.45f, -1));
+	code_container->set_v_size_flags(SIZE_EXPAND_FILL);
+	code_container->set_h_size_flags(SIZE_EXPAND_FILL);
+	_phone_sync_navigator();
+}
