+	const real_t edge_x = MIN(40 * scale, get_size().x * 0.25f);
+	const real_t edge_y = MIN(40 * scale, get_size().y * 0.25f);
+	const real_t right = get_size().x - (draw_minimap ? minimap_width : 0) - (v_scroll->is_visible() ? v_scroll->get_size().x : 0);
+	const real_t left = theme_cache.style_normal->get_margin(SIDE_LEFT) + gutters_width + gutter_padding;
+	const real_t bottom = get_size().y - (h_scroll->is_visible() ? h_scroll->get_size().y : 0);
+	const Vector2 pointer = phone_handle_pointer;
+	auto speed = [](real_t p_pos, real_t p_min, real_t p_max, real_t p_edge) -> real_t {
+		if (p_edge <= 0) { return 0; }
+		if (p_pos < p_min + p_edge) { return -CLAMP((p_min + p_edge - p_pos) / p_edge, 0.0f, 1.0f); }
+		if (p_pos > p_max - p_edge) { return CLAMP((p_pos - p_max + p_edge) / p_edge, 0.0f, 1.0f); }
+		return 0;
+	};
+	const real_t delta = MIN(p_delta, 0.05);
+	set_h_scroll(get_h_scroll() + speed(pointer.x, left, right, edge_x) * 650 * scale * delta);
+	set_v_scroll(get_v_scroll() + speed(pointer.y, 0, bottom, edge_y) * 650 * scale * delta / MAX(1, get_line_height()));
+	_phone_update_handle();
+}
