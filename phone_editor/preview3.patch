+// Choose a direction once per finger drag, retaining motion below the threshold.
+// Only the phone editor opts in; selection handles and two-finger pan stay free.
+struct TextEditTouchAxisLock {
+	Vector2 pending;
+	int axis = 0;
+	void reset() { pending = Vector2(); axis = 0; }
+	Vector2 filter(Vector2 p_motion) {
+		if (axis == 0) {
+			pending += p_motion;
+			if (pending.length_squared() < 64.0) {
+				return Vector2();
+			}
+			axis = Math::abs(pending.x) > Math::abs(pending.y) * 1.4 ? 1 : 2;
+			p_motion = pending;
+			pending = Vector2();
+		}
+		return axis == 1 ? Vector2(p_motion.x, 0) : Vector2(0, p_motion.y);
+	}
+};
