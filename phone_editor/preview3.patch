+void TextEdit::_phone_update_handle() {
+	if (dragging_caret_index < 0 || dragging_caret_index >= get_caret_count() || !is_visible_in_tree()) {
+		_phone_end_handle();
+		return;
+	}
+	const Ref<StyleBox> style = theme_cache.style_normal;
+	const real_t left = style->get_margin(SIDE_LEFT) + gutters_width + gutter_padding;
+	const real_t right = MAX(left + 1, get_size().x - style->get_margin(SIDE_RIGHT) - (draw_minimap ? minimap_width : 0) - (v_scroll->is_visible() ? v_scroll->get_size().x : 0));
+	const real_t top = style->get_margin(SIDE_TOP);
+	const real_t bottom = MAX(top + 1, get_size().y - style->get_margin(SIDE_BOTTOM) - (h_scroll->is_visible() ? h_scroll->get_size().y : 0));
+	Vector2 pos = phone_handle_pointer - selection_handle_drag_offset;
+	pos.x = CLAMP(pos.x, left, right - 1);
+	pos.y = CLAMP(pos.y, top, bottom - 1);
+	Point2i endpoint = get_line_column_at_pos(pos);
+	endpoint.y = CLAMP(endpoint.y, 0, get_line_count() - 1);
+	endpoint.x = CLAMP(endpoint.x, 0, get_line(endpoint.y).length());
+	phone_handle_anchor.y = CLAMP(phone_handle_anchor.y, 0, get_line_count() - 1);
+	phone_handle_anchor.x = CLAMP(phone_handle_anchor.x, 0, get_line(phone_handle_anchor.y).length());
+	phone_handle_endpoint = endpoint;
+	if (selection_handle_drag_type == SELECTION_HANDLE_END) {
+		select(phone_handle_anchor.y, phone_handle_anchor.x, endpoint.y, endpoint.x, dragging_caret_index);
+	} else {
+		select(endpoint.y, endpoint.x, phone_handle_anchor.y, phone_handle_anchor.x, dragging_caret_index);
+	}
+	_phone_update_loupe();
+	queue_redraw();
