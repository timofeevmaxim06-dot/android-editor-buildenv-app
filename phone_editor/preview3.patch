+
+internal data class PhoneGameWindowBounds(val x: Int, val y: Int, val width: Int, val height: Int)
+
+// Pure geometry used by creation, restore, drag, resize and orientation changes.
+internal fun fitPhoneGameWindow(x: Int, y: Int, width: Int, height: Int,
+	screenWidth: Int, screenHeight: Int, preserveAspect: Boolean): PhoneGameWindowBounds {
+	val sw = screenWidth.coerceAtLeast(1)
+	val sh = screenHeight.coerceAtLeast(1)
+	val maxW = (sw * 0.9).toInt().coerceAtLeast(1)
+	val maxH = (sh * 0.9).toInt().coerceAtLeast(1)
+	var w = if (width > 0) width else minOf(400, maxW)
+	var h = if (height > 0) height else minOf(400, maxH)
+	if (preserveAspect) {
+		val factor = minOf(1.0, maxW.toDouble() / w, maxH.toDouble() / h)
+		w = (w * factor).toInt().coerceIn(1, maxW)
+		h = (h * factor).toInt().coerceIn(1, maxH)
+	} else {
+		w = w.coerceAtMost(maxW)
+		h = h.coerceAtMost(maxH)
+	}
+	return PhoneGameWindowBounds(x.coerceIn(0, sw - w), y.coerceIn(0, sh - h), w, h)
+}
