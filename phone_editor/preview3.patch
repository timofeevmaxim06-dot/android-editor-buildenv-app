+void CodeTextEditor::_phone_insert_symbol(const String &p_symbol) {
+	ERR_FAIL_COND(p_symbol.length() != 1);
+	phone_scroll_button->set_pressed(false);
+	text_editor->grab_focus();
+	text_editor->apply_ime();
+	// Use CodeEdit's native input path: pairing, multicaret, undo and configured
+	// indentation keep the same semantics as a physical keyboard.
+	Ref<InputEventKey> key;
+	key.instantiate();
+	key->set_unicode(p_symbol[0]);
+	key->set_pressed(true);
+	text_editor->begin_complex_operation();
+	text_editor->gui_input(key);
+	text_editor->end_complex_operation();
+	text_editor->refresh_virtual_keyboard();
+}
