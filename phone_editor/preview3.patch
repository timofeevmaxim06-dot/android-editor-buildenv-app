+void TextEdit::_phone_update_loupe() {
+	if (!is_inside_tree() || phone_handle_finger < 0) { return; }
+	Control *loupe = Object::cast_to<Control>(ObjectDB::get_instance(phone_loupe_id));
+	if (!loupe) {
+		loupe = memnew(Control);
+		loupe->set_name("PhoneSelectionLoupe");
+		loupe->set_mouse_filter(MOUSE_FILTER_IGNORE);
+		loupe->set_z_index(4095);
+		loupe->set_clip_contents(true);
+		get_viewport()->add_child(loupe);
+		loupe->connect(SceneStringName(draw), callable_mp(this, &TextEdit::_phone_draw_loupe));
+		phone_loupe_id = loupe->get_instance_id();
+	}
+	const real_t scale = MAX(1.0f, theme_cache.base_scale);
+	const int font_size = MAX((int)(theme_cache.font_size * 1.8f), (int)(28 * scale));
+	const real_t margin = 12 * scale;
+	Rect2 area = get_viewport_rect();
+#ifdef ANDROID_ENABLED
+	area.size.y = MAX(0.0f, area.size.y - DisplayServer::get_singleton()->virtual_keyboard_get_height());
+#endif
+	area = area.grow(-margin);
+	const Size2 size(MIN(360 * scale, area.size.x), theme_cache.font->get_height(font_size) + 40 * scale);
+	if (area.size.x <= 0 || area.size.y < size.y) { loupe->hide(); return; }
+	const Vector2 finger = get_global_transform_with_canvas().xform(phone_handle_pointer);
+	const real_t gap = 72 * scale;
+	Vector2 origin(finger.x - size.x * 0.5f, finger.y - gap - size.y);
+	const Vector2 choices[] = { origin, Vector2(origin.x, finger.y + gap), Vector2(finger.x - gap - size.x, finger.y - size.y * 0.5f), Vector2(finger.x + gap, finger.y - size.y * 0.5f) };
+	real_t best_distance = -1;
+	for (Vector2 candidate : choices) {
+		candidate.x = CLAMP(candidate.x, area.position.x, area.get_end().x - size.x);
+		candidate.y = CLAMP(candidate.y, area.position.y, area.get_end().y - size.y);
+		const Vector2 nearest(CLAMP(finger.x, candidate.x, candidate.x + size.x), CLAMP(finger.y, candidate.y, candidate.y + size.y));
+		const real_t distance = finger.distance_squared_to(nearest);
+		if (distance > best_distance) { origin = candidate; best_distance = distance; }
+		// Keep the preferred above-finger location whenever the requested gap fits.
+		if (distance >= gap * gap) { break; }
+	}
+	// A tiny viewport cannot fit a legible lens away from the finger.
+	if (best_distance < 24 * scale * 24 * scale) { loupe->hide(); return; }
+	loupe->set_position(origin);
+	loupe->set_size(size);
+	loupe->set_meta("finger_position", finger);
+	loupe->set_meta("font_size", font_size);
+	loupe->show();
+	loupe->queue_redraw();
+}
+
+void TextEdit::_phone_draw_loupe() {
+	Control *loupe = Object::cast_to<Control>(ObjectDB::get_instance(phone_loupe_id));
+	if (!loupe || phone_handle_finger < 0) { return; }
+	const real_t scale = MAX(1.0f, theme_cache.base_scale);
+	const int font_size = MAX((int)(theme_cache.font_size * 1.8f), (int)(28 * scale));
+	const Size2 size = loupe->get_size();
+	loupe->draw_rect(Rect2(Vector2(), size), Color(0.08, 0.09, 0.12, 0.99));
+	loupe->draw_rect(Rect2(Vector2(2, 2) * scale, size - Vector2(4, 4) * scale), theme_cache.caret_color, false, 2 * scale);
+	const int line = CLAMP(phone_handle_endpoint.y, 0, get_line_count() - 1);
+	const String row = get_line(line);
+	const int column = CLAMP(phone_handle_endpoint.x, 0, row.length());
+	const int from = MAX(0, column - 18);
+	const int to = MIN(row.length(), column + 18);
+	// Shape a valid, self-contained slice. Never pass a negative length or a
+	// range from the original paragraph into a newly shaped string.
+	const String before = row.substr(from, column - from).replace("\t", "    ");
+	const String shown = row.substr(from, to - from).replace("\t", "    ");
+	const real_t caret_x = size.x * 0.5f;
+	const real_t text_x = caret_x - theme_cache.font->get_string_size(before, HORIZONTAL_ALIGNMENT_LEFT, -1, font_size).x;
+	const real_t baseline = (size.y - theme_cache.font->get_height(font_size)) * 0.5f + theme_cache.font->get_ascent(font_size);
+	loupe->draw_string(theme_cache.font, Vector2(text_x, baseline), shown, HORIZONTAL_ALIGNMENT_LEFT, -1, font_size, theme_cache.font_color);
+	loupe->draw_line(Vector2(caret_x, 10 * scale), Vector2(caret_x, size.y - 10 * scale), theme_cache.caret_color, 2 * scale);
+}
+
+void TextEdit::_draw_selection_handle(Vector2 p_pos) const {
+	Color handle_color = theme_cache.caret_color;
+	int line_height = get_line_height();
+
+	int handle_line_width = theme_cache.caret_width * MAX(1, theme_cache.base_scale);
+	RS::get_singleton()->canvas_item_add_line(text_ci, p_pos, p_pos + Vector2(0, line_height), handle_color, handle_line_width);
+
+	Vector2 circle_center = p_pos + Vector2(0, line_height + selection_handle_radius);
+	RS::get_singleton()->canvas_item_add_circle(text_ci, circle_center, selection_handle_radius, handle_color);
+}
+
+/*
+ * Returns true if p_column is at index 0 or if it is the first character of a wrapped line segment.
+ */
+bool TextEdit::_is_first_column(int p_line, int p_column) const {
+	bool is_first_column = p_column == 0;
+	if (!is_first_column && is_line_wrapped(p_line)) {
+		int wrap_index = get_line_wrap_index_at_column(p_line, p_column);
+		int wrap_index_last_column = get_line_wrap_index_at_column(p_line, p_column - 1);
+		is_first_column = wrap_index != wrap_index_last_column;
+	}
+	return is_first_column;
+}
+
+Vector<Point2i> TextEdit::_get_selection_handles_pos(int p_caret) const {
+	int selection_from_line = get_selection_from_line(p_caret);
+	int selection_from_column = get_selection_from_column(p_caret);
+	int selection_to_line = get_selection_to_line(p_caret);
+	int selection_to_column = get_selection_to_column(p_caret);
+	Rect2i start_rect = get_rect_at_line_column(selection_from_line, selection_from_column);
+	Rect2i end_rect = get_rect_at_line_column(selection_to_line, selection_to_column);
+
+	Point2i start_pos = start_rect.position;
+	if (start_pos.x != -1 && !_is_first_column(selection_from_line, selection_from_column)) {
+		start_pos.x += start_rect.size.x;
+	}
+
+	Point2i end_pos = end_rect.position;
+	if (end_pos.x != -1 && !_is_first_column(selection_to_line, selection_to_column)) {
+		end_pos.x += end_rect.size.x;
+	}
+
+	Vector<Point2i> result;
+	result.push_back(start_pos);
+	result.push_back(end_pos);
+	return result;
+}
