+void EditorDockManager::setup_phone_navigation(HBoxContainer *p_navigation, MenuButton *p_sections) {
+	phone_navigation = p_navigation;
+	phone_sections = p_sections;
+	phone_sections->get_popup()->connect("about_to_popup", callable_mp(this, &EditorDockManager::_phone_sections_open));
+	phone_sections->get_popup()->connect(SceneStringName(id_pressed), callable_mp(this, &EditorDockManager::_phone_section_selected));
+}
+
+void EditorDockManager::_phone_sections_open() {
+	PopupMenu *menu = phone_sections->get_popup();
+	menu->clear();
+	phone_section_targets.clear();
+	Vector<Button *> targets;
+	for (int i = 0; i < phone_navigation->get_child_count(); i++) {
+		Node *child = phone_navigation->get_child(i);
+		if (Button *button = Object::cast_to<Button>(child)) {
+			targets.push_back(button);
+		} else if (child->get_name() == "EditorMainScreenButtons") {
+			for (int j = 0; j < child->get_child_count(); j++) {
+				if (Button *button = Object::cast_to<Button>(child->get_child(j))) {
+					targets.push_back(button);
+				}
+			}
+		}
+	}
+	for (Button *button : targets) {
+		if (!button->is_visible() || button->is_disabled()) {
+			continue;
+		}
+		int id = phone_section_targets.size();
+		phone_section_targets.push_back(button->get_instance_id());
+		menu->add_radio_check_item(button->get_text(), id);
+		menu->set_item_checked(id, button->is_pressed());
+	}
+	menu->add_separator();
+	menu->add_icon_item(phone_sections->get_editor_theme_icon(SNAME("MainPlay")), TTR("Run Project"), 100);
+	menu->add_icon_item(phone_sections->get_editor_theme_icon(SNAME("PlayScene")), TTR("Run Current Scene"), 101);
+	menu->add_icon_item(phone_sections->get_editor_theme_icon(SNAME("Stop")), TTR("Stop"), 102);
+	menu->add_separator();
+	menu->add_icon_item(phone_sections->get_editor_theme_icon(SNAME("Save")), String::utf8("Сохранить сцены и скрипты"), 103);
+	menu->add_item(TTR("Editor Settings..."), 104);
+	menu->add_item(TTR("Export..."), 105);
+}
+
+void EditorDockManager::_phone_section_selected(int p_id) {
+	if (p_id >= 100 && p_id <= 105) {
+		EditorNode::get_singleton()->execute_phone_action(p_id - 100);
+		return;
+	}
+	ERR_FAIL_INDEX(p_id, phone_section_targets.size());
+	Button *button = ObjectDB::get_instance<Button>(phone_section_targets[p_id]);
+	if (button && button->is_visible() && !button->is_disabled()) {
+		button->emit_signal(SceneStringName(pressed));
+	}
+}
+
+void EditorDockManager::_phone_choose_node() {
+	focus_dock(SceneTreeDock::get_singleton());
+}
+
+void EditorDockManager::_update_phone_context() {
+	if (!phone_context || !phone_slot) {
+		return;
+	}
+	Control *active = phone_slot->get_current_tab_control();
+	bool needs_node = active && (active->is_class("InspectorDock") || active->is_class("SignalsDock") || active->is_class("GroupsDock"));
+	phone_context->set_visible(needs_node);
+	TypedArray<Node> nodes = EditorNode::get_singleton()->get_editor_selection()->get_selected_nodes();
+	String label = String::utf8("Узел не выбран");
+	if (nodes.size() == 1) {
+		Node *node = Object::cast_to<Node>(nodes[0]);
+		if (node) {
+			label = String::utf8("В сцене: ") + node->get_name();
+		}
+	} else if (nodes.size() > 1) {
+		label = String::utf8("Выбрано узлов: ") + itos(nodes.size());
+	}
+	phone_selection_label->set_text(label);
+	phone_selection_label->set_tooltip_text(label);
+}
+
+void EditorDockManager::_update_phone_buttons() {
+	if (!phone_slot) {
+		return;
+	}
+	Control *active = phone_slot->get_current_tab_control();
+	for (const KeyValue<EditorDock *, Button *> &entry : phone_buttons) {
+		entry.value->set_visible(entry.key->enabled);
+		entry.value->set_text(entry.key->get_display_title());
+		entry.value->set_pressed_no_signal(phone_panels->is_visible() && active == entry.key);
+	}
+	EditorNode::get_singleton()->get_editor_main_screen()->set_phone_workspace_active(phone_workspace->is_visible());
+	_update_phone_context();
+}
